{
  "name": "livelife-habit4-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone demo of the LiveLife Habit 4 (Think Win-Win) lesson, student assessment and teacher assessment.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p 3000",
    "dev:demo": "python services/demo-livelife/server.py",
    "build": "next build",
    "start": "node scripts/dev.mjs --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:demo": "python -m pytest services/demo-livelife/test_cases"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "^15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^3"
  }
}
