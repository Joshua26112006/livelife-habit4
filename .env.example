# Everything below is OPTIONAL. Without any of it the whole demo still runs; only the AI marking is off
# (answers are collected and the pages work, but the written answers are not given marks).

# Turn AI marking of the written answers ON. Anything else = off.
DEMO_LIVELIFE_SCORE=0

# One key is enough. OpenRouter is the default; OPENAI_API_KEY also works if you point DEMO_LIVELIFE_API_URL at OpenAI.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEMO_LIVELIFE_API_URL=https://openrouter.ai/api/v1/chat/completions
# DEMO_LIVELIFE_MODEL=openai/gpt-4o

# Where the Python demo service runs (default shown).
# DEMO_SERVICE_URL=http://localhost:8080
